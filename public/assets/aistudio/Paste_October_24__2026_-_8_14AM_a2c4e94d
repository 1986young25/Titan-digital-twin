        // ==============================================================================
        const lobeOrbs = [];
        const raycastTargets = [innerOrb];
        const phi = Math.PI * (3 - Math.sqrt(5)); // Golden spiral ratio
        const orbitRadius = 6.2;

        for (let i = 0; i < 8; i++) {
            const y = 1 - (i / 7) * 2;
            const rAtY = Math.sqrt(1 - y * y);
            const theta = phi * i;

            const posX = Math.cos(theta) * rAtY * orbitRadius;
            const posZ = Math.sin(theta) * rAtY * orbitRadius;
            const posY = y * (orbitRadius * 0.65);

            const orbGroup = new THREE.Group();
            orbGroup.position.set(posX, posY, posZ);

            // Satellite Shell
            const sGeo = new THREE.DodecahedronGeometry(0.7, 0);
            const sMat = new THREE.MeshStandardMaterial({
