            // Laser Synaptic Connection to Core
            const synGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(posX, posY, posZ)]);
            const synMat = new THREE.LineBasicMaterial({ color: 0x00e5ff, transparent: true, opacity: 0.3 });
            const line = new THREE.Line(synGeo, synMat);
            masterGroup.add(line);
        }

        // ==============================================================================
        // RAYCASTING & INTERACTION
        // ==============================================================================
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        window.addEventListener('click', (event) => {
            // Prevent raycasting through HUD buttons
            if (event.target.closest('.hud-panel') || event.target.closest('#inspector-modal')) return;

            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(raycastTargets, false);

            if (intersects.length > 0) {
                const target = intersects[0].object;
                if (target.userData.isCore) {
                    pulseCore();
                    logTerminal("[INTERACTION] Central Core Quantum Tesseract clicked: 3.69 Hz Resonance pulse fired.");
                } else if (target.userData.isLobe) {
                    const idx = target.userData.lobeIndex;
                    selectLobe(idx);
                    openModal(LOBES[idx]);
                }
            }
        });

        function pulseCore() {
            innerOrbMat.color.setHex(0xffd700);
            coreLight.intensity = 8.0;
            setTimeout(() => {
                innerOrbMat.color.setHex(0x00ffff);
                coreLight.intensity = 3.0;
            }, 350);
        }

        let temporalOffsetActive = true;
        function toggleTemporalOffset() {
            temporalOffsetActive = !temporalOffsetActive;
            logTerminal(`[4D TIMING] 40-Star temporal phase offset: ${temporalOffsetActive ? 'ENABLED' : 'LOCKED'}`);
        }

        function resetOrbPositions() {
            logTerminal("[TOPOLOGY] Synaptic vectors realigned to 376.5 Ω free-space baseline.");
        }

        function triggerCircuitBreaker() {
            logTerminal("[ALERT] Modulo-9 Circuit Breaker tripped: Inverting suspect vectors.");
            lobeOrbs[0].nucleus.material.color.setHex(0xff1744);
            setTimeout(() => {
                lobeOrbs[0].nucleus.material.color.setHex(0x00ff7f);
                logTerminal("[HEAL] Bitwise negation (~) cycle completed.");
            }, 1000);
        }

        // ==============================================================================
        // ANIMATION LOOP (3.69 Hz CADENCE & 4D TEMPORAL ROTATIONS)
        // ==============================================================================
        const clock = new THREE.Clock();
        const temporalPhaseOffset = (2 * Math.PI) / 40.0; // True 40-Star phase offset

        function animate() {
            requestAnimationFrame(animate);
            const t = clock.getElapsedTime();
            controls.update();

            // Rotate Master Assembly
            masterGroup.rotation.y = t * 0.12;

            // Rotate Star 1 (Gold Primary Rim)
            starPrimary.rotation.z = t * 0.25;
            starPrimary.rotation.x = Math.sin(t * 0.2) * 0.1;

            // Rotate Star 2 (Cyan Nested Rim) with Temporal 4D Phase Offset
            if (temporalOffsetActive) {
                starOffset.rotation.z = -(t * 0.25 + temporalPhaseOffset);
                starOffset.rotation.y = Math.cos(t * 0.3) * 0.15;
            } else {
                starOffset.rotation.z = -starPrimary.rotation.z;
            }

            // Central Core 3.69 Hz Breathing Pulse
            const coreScale = 1.0 + 0.09 * Math.sin(t * 3.69 * Math.PI * 2);
            innerOrb.scale.set(coreScale, coreScale, coreScale);

            // Inscription Ring Counter-Rotation
            ringTex.offset.x = (t * 0.04) % 1;

            // Orbiting Lobe Rotations
            lobeOrbs.forEach((orb) => {
                orb.outer.rotation.y += 0.02;
                orb.outer.rotation.x += 0.01;
            });

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        animate();
    </script>
