        const coreLight = new THREE.PointLight(0x00e5ff, 3, 25);
        scene.add(coreLight);
        const goldLight = new THREE.PointLight(0xffd700, 2, 20);
        goldLight.position.set(0, 5, 0);
        scene.add(goldLight);

        const masterGroup = new THREE.Group();
        scene.add(masterGroup);

        // ==============================================================================
        // CENTRAL CORE: DOUBLE-EDGED 4D STAR OF DAVID (HEXAGRAM MERKABA)
        // ==============================================================================
        function createHexagramShape(radius) {
            const shape = new THREE.Shape();
            const angleStep = Math.PI / 3;
            for (let i = 0; i < 6; i++) {
                const a1 = i * angleStep;
                const a2 = a1 + angleStep / 2;
                const rOuter = radius;
                const rInner = radius * 0.57735; // Hexagram vertex proportion
                const x1 = Math.cos(a1) * rOuter;
                const y1 = Math.sin(a1) * rOuter;
                const x2 = Math.cos(a2) * rInner;
                const y2 = Math.sin(a2) * rInner;
                if (i === 0) shape.moveTo(x1, y1);
                else shape.lineTo(x1, y1);
                shape.lineTo(x2, y2);
            }
            shape.closePath();
            return shape;
        }

        // Generate Double-Edged 3D Star of David via Extrusion
        const starShape = createHexagramShape(1.8);
        const extrudeSettings = { steps: 1, depth: 0.35, bevelEnabled: true, bevelThickness: 0.12, bevelSize: 0.1, bevelSegments: 3 };
        const starGeometry = new THREE.ExtrudeGeometry(starShape, extrudeSettings);
        starGeometry.center();

        const goldStarMat = new THREE.MeshStandardMaterial({
            color: 0xffd700,
            emissive: 0xaa7700,
            metalness: 0.85,
            roughness: 0.25,
            wireframe: false
        });

