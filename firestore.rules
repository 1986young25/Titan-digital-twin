rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('clearanceLevel' in data) || (data.clearanceLevel is string && data.clearanceLevel.size() <= 128)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 128)) &&
             (!('lastLogin' in data) || data.lastLogin is string);
    }

    function isValidTelemetryEvent(data) {
      return data.keys().hasAll(['id', 'vehicleId', 'vibrationDelta', 'persistenceCount']) &&
             data.id is string && data.id.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             data.vibrationDelta is number &&
             data.persistenceCount is int &&
             (!('alpha' in data) || data.alpha is number) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 64)) &&
             (!('timestamp' in data) || data.timestamp is string) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('operatorEmail' in data) || (data.operatorEmail is string && data.operatorEmail.size() <= 128));
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.type is string && data.type.size() <= 64 &&
             data.status is string && data.status.size() <= 64 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 128)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && incoming().uid == resource.data.uid;
      allow delete: if false;
    }

    match /telemetry_events/{eventId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(eventId) && isValidTelemetryEvent(incoming());
      allow update: if isSignedIn() && isValidId(eventId) && isValidTelemetryEvent(incoming()) && incoming().id == resource.data.id;
      allow delete: if isSignedIn() && isValidId(eventId);
    }

    match /assets/{assetId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(assetId) && isValidAsset(incoming());
      allow update: if isSignedIn() && isValidId(assetId) && isValidAsset(incoming()) && incoming().id == resource.data.id;
      allow delete: if isSignedIn() && isValidId(assetId);
    }
  }
}
